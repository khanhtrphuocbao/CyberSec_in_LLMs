# MedQA-RAG Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Third-party API (optional) - leave empty to use OpenAI directly
# Set base URL for OpenAI-compatible APIs (e.g., Azure, local models, proxies)
# OPENAI_API_BASE=https://api.openai.com/v1
# Example for Codex proxy:
# OPENAI_API_BASE=https://codex.dichvumang86.net/v1

# Optional: Model configuration
# DEFAULT_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: ChromaDB RAG configuration
# RAG_PERSIST_DIR=/Users/mac/Developers/MedQA_RAG/MedQA_ChromaDB_Injected
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=5

# Optional: HuggingFace (for local embeddings)
# USE_HUGGINGFACE=false
# HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Optional: Evaluation settings
# MEDQA_TEST_PATH=/Users/mac/Developers/MedQA_RAG/dataset_MedQA-USMLE/questions/US/test.jsonl
# MAX_QUESTIONS=1273
# EVALUATION_OUTPUT_DIR=./results
