# MedQA-RAG Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=
# DEFAULT_MODEL=gpt-5.6-luna

# Third-party API (optional) - leave empty to use OpenAI directly
# Set base URL for OpenAI-compatible APIs (e.g., Azure, local models, proxies)
# Optional: Model configuration

# Optional: ChromaDB RAG configuration
# RAG_PERSIST_DIR=/Users/mac/Developers/MedQA_RAG/MedQA_ChromaDB_Injected
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=5

#HuggingFace (for local embeddings)
#USE_HUGGINGFACE=true
#HF_MODEL_NAME=lokeshch19/ModernPubMedBERT
#HF_TOKEN=your_huggingface_token_here
